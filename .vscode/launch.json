{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    //
    // Every configuration that opens a database ASKS for its environment on F5, instead of shipping one
    // entry per environment — which is how the API server and the terminal each came to exist twice,
    // once "— PostgreSQL" and once "— SQL Server". The picker replaces the duplicate.
    //
    // The two projects do NOT share one: altea/altea holds the framework suite, whose only environments
    // are the two DIALECTS and whose connection string is ALTEA_TEST_DB; eastwind NAMES its environments
    // (local / dev / test / live, as its scripts do) and reads EASTWIND_DB. Offer an eastwind name to the
    // framework suite and `--env-file` finds no file and node exits before the first line runs, so the
    // inputs are split — `alteaTestEnv` and `eastwindEnv`.
    //
    // RUNNING AND DEBUGGING TESTS IS NOT HERE. Twelve packages carry suites today and eastwind will add
    // more, so "run all" × "run one" × package would be an entry per package forever. Both axes are
    // covered without enumeration:
    //   - one test, with a debugger → the Test Explorer (settings.json discovers every package's dist
    //     suites from two patterns; a new package appears on its own)
    //   - a whole package, against a database → its own scripts, which already exist and are identical
    //     everywhere: `pnpm --filter @altea/altea-auth test:postgres`, listed in VS Code's NPM Scripts view
    // What stays below is the one test-adjacent thing neither covers: BUILDING a suite's database, which
    // is a program rather than a test. Only altea's is here because it is the one worth stepping through;
    // the sibling packages seed theirs with `pnpm --filter <pkg> gen:postgres`.
    "version": "0.2.0",
    "configurations": [
        {
            // DESTRUCTIVE: drops and rebuilds the suite's database, then seeds the fixture.
            "type": "node",
            "request": "launch",
            "name": "altea test (generate DB)",
            "preLaunchTask": "build @altea/altea test (tspc -b)",
            "cwd": "${workspaceFolder}/altea/altea",
            "runtimeArgs": [
                "--enable-source-maps",
                "--import",
                "./register.mjs",
                "--env-file=.env.${input:alteaTestEnv}"
            ],
            "program": "${workspaceFolder}/altea/altea/dist/test/server/generateEnvironment.js",
            "outFiles": [
                "${workspaceFolder}/altea/altea/dist/**/*.js"
            ],
            "sourceMaps": true,
            "resolveSourceMapLocations": [
                "${workspaceFolder}/**",
                "!**/node_modules/**"
            ],
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**",
                "**/node_modules/pg/lib/native/**"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "eastwind API server",
            "preLaunchTask": "build eastwind",
            "cwd": "${workspaceFolder}/eastwind",
            "runtimeArgs": [
                "--enable-source-maps",
                "--import",
                "@altea/altea/register.mjs",
                "--env-file=.env.${input:eastwindEnv}"
            ],
            "program": "${workspaceFolder}/eastwind/dist/app/webServer.server.js",
            "outFiles": [
                "${workspaceFolder}/eastwind/dist/**/*.js"
            ],
            "sourceMaps": true,
            "resolveSourceMapLocations": [
                "${workspaceFolder}/**",
                "!**/node_modules/**"
            ],
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**",
                "**/node_modules/pg/lib/native/**"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "eastwind terminal",
            "preLaunchTask": "build eastwind terminal",
            "cwd": "${workspaceFolder}/eastwind",
            "runtimeArgs": [
                "--enable-source-maps",
                "--import",
                "@altea/altea/register.mjs",
                "--env-file=.env.${input:eastwindEnv}"
            ],
            "program": "${workspaceFolder}/eastwind/dist/terminal/terminal.js",
            "outFiles": [
                "${workspaceFolder}/eastwind/dist/**/*.js"
            ],
            "sourceMaps": true,
            "resolveSourceMapLocations": [
                "${workspaceFolder}/**",
                "!**/node_modules/**"
            ],
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**",
                "**/get-intrinsic/**",
                "**/pg/lib/native/client.js"
            ]
        },
        {
            // The SPA half of the stack — vite dev, serving :5173 and proxying /api to the host above
            // (vite.client.config.ts). Both ports come from eastwind/scripts/ports.mjs; THIS path has no
            // environment to read (vite is a binary, so there is no --env-file to splice in), and falls
            // back to eastwind/.env.local — which is where a clone meant to run beside another one puts
            // PORT and CLIENT_PORT. It is a LAUNCH CONFIGURATION rather than a task purely so the
            // compounds below can own it: stopping a compound stops every process in it, which a
            // background task left running in a terminal would not do.
            //
            // Nothing here is debugged — pnpm and vite run under the adapter only so they die with the
            // session. What keeps the emitted JS vite consumes fresh is the preLaunchTask: the same
            // `tspc -b --watch` the `stack` script runs beside the API, and the reason this is not a bare
            // `vite`. VS Code waits for the watcher's FIRST pass (the $tsc-watch background matcher in
            // tasks.json) before vite starts, so the first page load never reads half-written output.
            "type": "node",
            "request": "launch",
            "name": "eastwind client (vite dev)",
            "preLaunchTask": "watch types",
            "cwd": "${workspaceFolder}/eastwind",
            "runtimeExecutable": "pnpm",
            "runtimeArgs": [
                "run",
                "dev:client"
            ],
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ],
    "inputs": [
        {
            // altea/altea ships exactly these two (.env.example is the tracked template). The framework
            // suite's environment IS its dialect: one test database per engine, each naming itself in
            // ALTEA_TEST_DB — so this picker is the dialect and nothing else.
            "id": "alteaTestEnv",
            "type": "pickString",
            "description": "Framework suite — which dialect to run against (altea/altea/.env.*, read as ALTEA_TEST_DB)",
            "options": [
                {
                    "label": "sqlserver — the SQL Server test database",
                    "value": "sqlserver"
                },
                {
                    "label": "postgres — the PostgreSQL test database",
                    "value": "postgres"
                }
            ],
            "default": "sqlserver"
        },
        {
            // eastwind/.env.<environment> — the very names its scripts take (`pnpm --filter eastwind
            // stack local`, see eastwind/scripts/withEnv.mjs), so what you pick here and what you type
            // there mean the same database. Keep the list in step with the files on disk: node's
            // --env-file is not optional, and a name with no file fails before the first line runs.
            "id": "eastwindEnv",
            "type": "pickString",
            "description": "eastwind — which environment to run as (eastwind/.env.*, read as EASTWIND_DB)",
            "options": [
                {
                    "label": "local — what the local stack serves, and what the Playwright suite drives",
                    "value": "local"
                },
                {
                    "label": "dev — shared development",
                    "value": "dev"
                },
                {
                    "label": "test — staging / QA",
                    "value": "test"
                },
                {
                    "label": "live — production",
                    "value": "live"
                },
                {
                    "label": "postgres — port-era PostgreSQL database",
                    "value": "postgres"
                },
                {
                    "label": "sqlserver — port-era SQL Server database",
                    "value": "sqlserver"
                },
                {
                    "label": "swpostgres — a Signum Southwind database, read through legacyMode",
                    "value": "swpostgres"
                }
            ],
            "default": "local"
        }
    ],
    // `pnpm --filter eastwind stack <env>` with the API under the DEBUGGER. The script's three processes
    // are all here — the type watcher (the client configuration's preLaunchTask), the API host and vite —
    // and BOTH ports are freed first exactly as the script does, so a session that was stopped hard does
    // not meet its own leftover with EADDRINUSE — and vite, which would not have died on a taken port but
    // moved to :5174 and served the stack where nobody was told to look, now owns 5173 or says why not
    // (`strictPort`). `stopAll` is the script's `concurrently -k`: stop one, stop
    // all, and Ctrl+C leaves nothing behind. Opens on http://localhost:5173.
    //
    // ONE, over the tspc output you just edited — restart the session to pick up an edit, the watcher has
    // already recompiled it. Debugging the deployable single-file bundle instead was a second copy of
    // every entry here (a launch configuration, a compound and a bundling task) for a build that is not
    // what you are editing; `pnpm --filter eastwind bundle` still produces it, and the "bundle eastwind"
    // task still runs that.
    "compounds": [
        {
            "name": "eastwind full stack",
            "configurations": [
                "eastwind API server",
                "eastwind client (vite dev)"
            ],
            "preLaunchTask": "free eastwind dev ports",
            "stopAll": true
        }
    ]
}