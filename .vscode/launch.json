{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "altea-test (current file)",
            "preLaunchTask": "build altea-test (tspc -b)",
            "cwd": "${workspaceFolder}/altea/altea-test",
            "env": {
                "ALTEA_TEST_LOG_SQL": "1"
            },
            "runtimeArgs": [
                "--enable-source-maps",
                "--import",
                "./register.mjs",
                "--env-file=${input:envFile}",
                "--test",
                "--test-name-pattern=${input:testName}"
            ],
            "program": "${workspaceFolder}/altea/altea-test/dist/test/${fileBasenameNoExtension}.js",
            "outFiles": [
                "${workspaceFolder}/altea/altea-test/dist/**/*.js"
            ],
            "sourceMaps": true,
            "resolveSourceMapLocations": [
                "${workspaceFolder}/**",
                "!**/node_modules/**"
            ],
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "altea-test (all files)",
            "preLaunchTask": "build altea-test (tspc -b)",
            "cwd": "${workspaceFolder}/altea/altea-test",
            "runtimeArgs": [
                "--enable-source-maps",
                "--import",
                "./register.mjs",
                "--env-file=${input:envFile}",
                "--test",
                "dist/test/**/*.test.js"
            ],
            "outFiles": [
                "${workspaceFolder}/altea/altea-test/dist/**/*.js"
            ],
            "sourceMaps": true,
            "resolveSourceMapLocations": [
                "${workspaceFolder}/**",
                "!**/node_modules/**"
            ],
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "altea-test (generate DB)",
            "preLaunchTask": "build altea-test (tspc -b)",
            "cwd": "${workspaceFolder}/altea/altea-test",
            "runtimeArgs": [
                "--enable-source-maps",
                "--import",
                "./register.mjs",
                "--env-file=${input:envFile}"
            ],
            "program": "${workspaceFolder}/altea/altea-test/dist/test/generateEnvironment.js",
            "outFiles": [
                "${workspaceFolder}/altea/altea-test/dist/**/*.js"
            ],
            "sourceMaps": true,
            "resolveSourceMapLocations": [
                "${workspaceFolder}/**",
                "!**/node_modules/**"
            ],
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "quote-transformer-test (Debug)",
            "preLaunchTask": "tsc: build - quote-transformer-test",
            "program": "${workspaceFolder}/quote-transformer-test/dist/initTransformer.js",
            "cwd": "${workspaceFolder}/quote-transformer-test/",
            "outFiles": [
                "${workspaceFolder}/quote-transformer-test/dist/**/*.js"
            ],
            "sourceMaps": true
        },
        {
            "type": "node",
            "request": "launch",
            "name": "quote-transformer-test (Debug Jest)",
            "preLaunchTask": "tsc: build - quote-transformer-test",
            "program": "${workspaceFolder}/quote-transformer-test/node_modules/jest/bin/jest.js",
            "args": [
                "--runInBand"
            ],
            "cwd": "${workspaceFolder}/quote-transformer-test/",
            "outFiles": [
                "${workspaceFolder}/quote-transformer-test/dist/**/*.js"
            ],
            "sourceMaps": true,
            "console": "integratedTerminal"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "eastwind server (logic/main.ts)",
            "preLaunchTask": "build eastwind server bundle",
            "program": "${workspaceFolder}/eastwind/dist/server-bundle/main.js",
            "cwd": "${workspaceFolder}/eastwind/",
            "outFiles": [
                "${workspaceFolder}/eastwind/dist/server-bundle/**/*.js"
            ],
            "sourceMaps": true,
            "resolveSourceMapLocations": [
                "${workspaceFolder}/**",
                "!**/node_modules/**"
            ],
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "eastwind API server — PostgreSQL",
            "preLaunchTask": "build types (tspc -b)",
            "cwd": "${workspaceFolder}/eastwind",
            "runtimeArgs": [
                "--enable-source-maps",
                "--import",
                "./register.mjs",
                "--env-file=.env.postgres"
            ],
            "program": "${workspaceFolder}/eastwind/dist/server/webServer.js",
            "outFiles": [
                "${workspaceFolder}/eastwind/dist/**/*.js"
            ],
            "sourceMaps": true,
            "resolveSourceMapLocations": [
                "${workspaceFolder}/**",
                "!**/node_modules/**"
            ],
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "eastwind API server — SQL Server",
            "preLaunchTask": "build types (tspc -b)",
            "cwd": "${workspaceFolder}/eastwind",
            "runtimeArgs": [
                "--enable-source-maps",
                "--import",
                "./register.mjs",
                "--env-file=.env.sqlserver"
            ],
            "program": "${workspaceFolder}/eastwind/dist/server/webServer.js",
            "outFiles": [
                "${workspaceFolder}/eastwind/dist/**/*.js"
            ],
            "sourceMaps": true,
            "resolveSourceMapLocations": [
                "${workspaceFolder}/**",
                "!**/node_modules/**"
            ],
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ],
    "inputs": [
        {
            "id": "testName",
            "type": "promptString",
            "description": "node --test-name-pattern regex (leave empty to run every test in the file)",
            "default": ""
        },
        {
            "id": "envFile",
            "type": "pickString",
            "description": "Database connection (env file loaded into ALTEA_TEST_DB)",
            "options": [
                ".env.sqlserver",
                ".env.postgres"
            ],
            "default": ".env.sqlserver"
        }
    ]
}