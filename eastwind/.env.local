
NORTHWIND_DB=postgresql://user:password@localhost:5432/northwind
# --- PostgreSQL (libpq URL) ---
EASTWIND_DB=postgresql://user:password@localhost:5432/eastwind
AUTH_TOKEN_KEY=SomeSecret
# --- The two DEVELOPMENT PORTS live in scripts/ports.mjs and are not repeated here: PORT for the api,
#     CLIENT_PORT for the vite dev server. Set BOTH to run this clone beside another one; everything
#     follows (vite, its /api proxy target, free:port, the Playwright base URL, the seeded urlLeft). ---

# --- Client-only (vite reads .env.local automatically, in every mode) ---
VITE_PASSWORD_IS_USERNAME=true

# This database is a throwaway test fixture — `gen:environment local` may drop and rebuild it.
# The generator refuses without this, so `gen:environment live` cannot destroy anything. See .env.example.
EASTWIND_DISPOSABLE_DB=true
