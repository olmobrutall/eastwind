# eastwind — environment TEMPLATE. Copy to `.env.<environment>` and pass that name to every script:
#   pnpm --filter eastwind stack local      pnpm --filter eastwind server live
#   pnpm --filter eastwind terminal dev     pnpm --filter eastwind terminal test sync
# The name is REQUIRED — there is no default, so nothing can start against the wrong database by
# omission. eastwind ships `.env.local` / `.env.dev` / `.env.test` / `.env.live`; only THIS file is
# tracked in git (see .gitignore).
#
# ONLY what cannot live in the database is here: a connection, a credential, or a choice made while the
# schema is BUILT, before any row can be read. Every module's SETTINGS (mail, chatbot keys, workflow, SMS,
# the three directory configurations) are members of the ONE ApplicationConfiguration row, edited at
# /view/ApplicationConfiguration — Southwind's model. Nothing below seeds that row: a fresh database gets
# plain dev defaults from the CreateCulturesAndConfiguration migration.
#
# NEVER commit a real connection string, password or key: every `.env.<environment>` is git-ignored.

# --- The database ----------------------------------------------------------------------------------------
# The dialect is chosen by the PREFIX: a value starting with "postgres" → PostgreSQL, otherwise SQL Server.
# The database must ALREADY EXIST (altea has no CREATE DATABASE); `terminal new` = clean + generate into it.
EASTWIND_DB=postgres://YOUR_USER:YOUR_PASSWORD_HERE@localhost:5432/eastwind
# EASTWIND_DB=Server=localhost,1433;Database=eastwind;User Id=YOUR_USER;Password=YOUR_PASSWORD_HERE;Encrypt=true;TrustServerCertificate=true

# --- May this database be DROPPED? ------------------------------------------------------------------------
# `gen:environment <environment>` drops and recreates the database above, then reloads the test seed. It
# takes the environment by NAME, so `live` is one keystroke from `local` — and the generator refuses to run
# unless the environment's own .env file says the database is expendable.
#
# Set it in .env.local (or whichever environment is yours to lose). NEVER in .env.test or .env.live: there
# is deliberately no command-line flag that overrides this, so those environments simply cannot be
# generated, however the command is typed.
# EASTWIND_DISPOSABLE_DB=true

# --- The Northwind SOURCE database (terminal only) --------------------------------------------------------
# Where the `csharp` migrations READ the demo data from (LoadRegions, LoadEmployees, LoadOrders, …) — a
# second connector, whose DIALECT follows this connection string exactly as EASTWIND_DB's does:
# "postgres…" is PostgreSQL, anything else is SQL Server (terminal/northwindSchema.ts). So run Postgres
# against Postgres and SQL Server against SQL Server.
#
# The DATABASE has to exist (altea has no CREATE DATABASE); its CONTENT does not — `terminal seed-northwind`
# creates it from the vendor script that matches the dialect, and `terminal csharp` runs that as its first
# step, so a fresh machine needs nothing but an empty database here. Both scripts ship in terminal/
# (Northwind.SqlServer.sql = Microsoft's instnwnd.sql, Northwind.Postgree.sql = the pg_dump port).
#
# tedious connects over TCP, so a SQL Server instance needs TCP/IP ENABLED in SQL Server Configuration
# Manager (SQLServerManager16.msc) — SSMS reaching "localhost" proves nothing, it falls back to shared memory.
NORTHWIND_DB=Server=localhost,1433;Database=Northwind;User Id=YOUR_USER;Password=YOUR_PASSWORD_HERE;Encrypt=true;TrustServerCertificate=true
# NORTHWIND_DB=postgresql://YOUR_USER:YOUR_PASSWORD_HERE@localhost:5432/northwind

# --- Which ApplicationConfiguration row this process runs as -----------------------------------------------
# The row whose Environment matches. CreateCulturesAndConfiguration seeds a row with this name, so a fresh
# database needs nothing here.
# DB_ENVIRONMENT=Development

# --- Web host ----------------------------------------------------------------------------------------------
# PORT=3001                             # the api; the vite client proxies /api to it (VITE_API_TARGET)
# SQL_LOG=1                             # log every statement to the console

# The key the auth TOKEN is signed with (Southwind's secret in Startup.cs / AuthServer.Start). Unset, a
# public dev fallback is used and the server warns about it on every boot — so anything but local dev
# needs a real value here.
# AUTH_TOKEN_KEY=

# --- Choices made while the schema is BUILT, before any row can be read -------------------------------------
# WHICH directory module owns the login flow (AuthLogic.authorizer is a single slot). The configurations
# themselves are the Azure AD / Open ID / Windows AD tabs of the row; all three are empty on a fresh
# database, so eastwind authenticates against its own user table until one is filled in.
# EASTWIND_AD_PROVIDER=azuread          # azuread (default) | openid | windowsad

# Whether to name things the way SIGNUM names them, wherever altea's own convention diverges for no
# reason but taste (SchemaSettings.legacyMode). Point eastwind at a database a Signum application
# generated — a Southwind, say — and `terminal sync` then reads as a MIGRATION (the model differences)
# rather than a rebuild (every table renamed). Today it covers ONE divergence: a `@part` row table joins
# to its owner with a SINGLE underscore on Postgres, `role_inherits_from` where altea writes
# `role__inherits_from`. Inert on SQL Server, which has no double underscore to avoid.
# LegacyMode=true

# WHICH backend holds the bytes of every file store. WHERE a store writes is its own NAME — `./files/<name>`
# for "folder", a container / bucket named after it for the other two (eastwindFileStores.server.ts).
# EASTWIND_FILE_STORE=folder            # folder | azure | s3

# Whether the "browse a user's Outlook mailbox" search page is registered at all (needs Entra).
# EASTWIND_REMOTE_EMAILS=false

# --- Cloud file-store credentials ----------------------------------------------------------------------------
# Credentials stay in the environment, never in the row (Southwind passes them to Starter.Start).
# Azure Blob Storage (@altea/altea-files-azure) — one container per store, created on first write.
# EASTWIND_AZURE_STORAGE_CONNECTION_STRING=
# S3 / MinIO (@altea/altea-files-s3) — see that package's docker-compose.yml.example for a local MinIO.
# EASTWIND_S3_ENDPOINT=http://localhost:9000  # omit for real AWS
# EASTWIND_S3_ACCESS_KEY=
# EASTWIND_S3_SECRET_KEY=
# EASTWIND_S3_REGION=                          # required by the AWS SDK; defaults to us-east-1
# EASTWIND_S3_BUCKET=                          # ONE shared bucket; each store becomes a key prefix in it
# EASTWIND_S3_FORCE_PATH_STYLE=true            # false for AWS virtual-hosted URLs

# --- The CLIENT's own flags go in eastwind/.env.local (vite reads that file, not this one) --------------------
#   VITE_PASSWORD_IS_USERNAME=true      # each seeded user's password IS their name — drops the password box
#   VITE_WINDOWS_AUTH=true              # show the 'Windows user' sign-in button (EASTWIND_AD_PROVIDER=windowsad)
#   VITE_API_TARGET=http://localhost:3001
