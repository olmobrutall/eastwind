# eastwind terminal / server database connection.
# Copy to .env.postgres or .env.sqlserver and fill in your own values.
# The dialect is chosen by the prefix: a value starting with "postgres" → PostgreSQL, otherwise SQL Server.
# The database must ALREADY EXIST (altea has no CREATE DATABASE); `terminal new` = clean + generate into it.

# --- PostgreSQL (libpq URL) ---
EASTWIND_DB=postgres://YOUR_USER:YOUR_PASSWORD_HERE@localhost:5432/eastwind

# --- SQL Server (mssql connection string) ---
# EASTWIND_DB=Server=localhost;Database=eastwind;User Id=YOUR_USER;Password=YOUR_PASSWORD_HERE;TrustServerCertificate=true

# --- Mail (see eastwindEmail.server.ts) ---
# EASTWIND_MAIL_CULTURE=en-US
# EASTWIND_MAIL_URL_LEFT=http://localhost:5173
# EASTWIND_MAIL_SEND=false
# EASTWIND_MAIL_RECEIVE=false           # the POP3 side; false makes a poll fail loudly instead of no-op
# EASTWIND_MAIL_OVERRIDE=               # send EVERY message here instead (a test catch-all)
# EASTWIND_REMOTE_EMAILS=false          # the "browse a user's Outlook mailbox" search page (needs Entra)

# --- File storage (see eastwindFileStores.server.ts) -----------------------------------------------------
# Which BACKEND holds the bytes of every file store (attachments, profile photos, …). "folder" is the
# default and needs nothing; the other two need @altea/altea-files-azure / -s3 credentials below.
# EASTWIND_FILE_STORE=folder            # folder | azure | s3
# EASTWIND_FILES_EMAILATTACHMENTS=./files/emailAttachments   # per-store folder override ("folder" only)
# EASTWIND_FILES_PROFILEPHOTOS=./files/profilePhotos

# Azure Blob Storage (@altea/altea-files-azure) — one container per store, created on first write.
# EASTWIND_AZURE_STORAGE_ACCOUNT=
# EASTWIND_AZURE_STORAGE_KEY=
# EASTWIND_AZURE_STORAGE_CONNECTION_STRING=   # instead of the account + key pair

# S3 / MinIO (@altea/altea-files-s3) — see that package's docker-compose.yml.example for a local MinIO.
# EASTWIND_S3_ENDPOINT=http://localhost:9000  # omit for real AWS
# EASTWIND_S3_ACCESS_KEY=
# EASTWIND_S3_SECRET_KEY=
# EASTWIND_S3_REGION=                          # required by the AWS SDK; defaults to us-east-1
# EASTWIND_S3_BUCKET=                          # ONE shared bucket; each store becomes a key prefix in it
# EASTWIND_S3_FORCE_PATH_STYLE=true            # false for AWS virtual-hosted URLs

# --- Directory login (see eastwindAuthAD.server.ts) -----------------------------------------------------
# Everything below is OPTIONAL and DISABLED by default: without it eastwind authenticates against its own
# user table. Only ONE directory can own the login flow (AuthLogic.authorizer is a single slot):
# EASTWIND_AD_PROVIDER=azuread          # azuread (default) | openid | windowsad
# EASTWIND_AD_DEFAULT_ROLE=             # role NAME a directory-created user gets when no mapping matches
# (the photo store's location is EASTWIND_FILES_PROFILEPHOTOS, under "File storage" above)

# Azure AD / Entra ID (@altea/altea-auth-azuread)
# EASTWIND_AZUREAD_ENABLED=true
# EASTWIND_AZUREAD_TYPE=AzureAD         # AzureAD | B2C | ExternalID
# EASTWIND_AZUREAD_APPLICATION_ID=00000000-0000-0000-0000-000000000000
# EASTWIND_AZUREAD_DIRECTORY_ID=00000000-0000-0000-0000-000000000000
# EASTWIND_AZUREAD_TENANT_NAME=          # B2C / ExternalID only
# EASTWIND_AZUREAD_CLIENT_SECRET=        # Microsoft Graph only (directory queries / photos), never for sign-in
# EASTWIND_AZUREAD_SIGNIN_SIGNUP_FLOW=
# EASTWIND_AZUREAD_SIGNIN_FLOW=
# EASTWIND_AZUREAD_SIGNUP_FLOW=
# EASTWIND_AZUREAD_EDIT_PROFILE_FLOW=
# EASTWIND_AZUREAD_RESET_PASSWORD_FLOW=
# EASTWIND_AZUREAD_USE_DELEGATED_PERMISSION=false
# EASTWIND_AZUREAD_AUTO_CREATE_USERS=false
# EASTWIND_AZUREAD_AUTO_UPDATE_USERS=false

# OpenID Connect (@altea/altea-auth-openid)
# EASTWIND_OPENID_ENABLED=true
# EASTWIND_OPENID_AUTHORITY=https://keycloak.example.com/realms/myrealm
# EASTWIND_OPENID_CLIENT_ID=eastwind
# EASTWIND_OPENID_CLIENT_SECRET=         # omit for a public (SPA) client
# EASTWIND_OPENID_SCOPES=openid profile email
# EASTWIND_OPENID_ROLE_CLAIM_PATH=realm_access.roles
# EASTWIND_OPENID_AVOID_SSL_VERIFY=false # DEVELOPMENT ONLY (a self-signed provider)
# EASTWIND_OPENID_AUTO_CREATE_USERS=false
# EASTWIND_OPENID_AUTO_UPDATE_USERS=false

# Windows Active Directory (@altea/altea-auth-windowsad)
# EASTWIND_WINDOWSAD_ENABLED=true        # login with a typed name + password, validated by an LDAP bind
# EASTWIND_WINDOWSAD_WINDOWS_AUTH=false  # integrated SSO — needs a Negotiate provider, see WindowsADServer
# EASTWIND_WINDOWSAD_DOMAIN_NAME=example.com
# EASTWIND_WINDOWSAD_LDAP_URL=           # defaults to ldap://<domain name>
# EASTWIND_WINDOWSAD_BASE_DN=            # defaults to the domain name as DC components
# EASTWIND_WINDOWSAD_REGISTRY_USERNAME=  # a lookup account, when the host is not a domain member
# EASTWIND_WINDOWSAD_REGISTRY_PASSWORD=
# EASTWIND_WINDOWSAD_AUTO_CREATE_USERS=false
# EASTWIND_WINDOWSAD_AUTO_UPDATE_USERS=false
