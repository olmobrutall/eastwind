# eastwind terminal / server database connection.
# Copy to .env.postgres or .env.sqlserver and fill in your own values.
# The dialect is chosen by the prefix: a value starting with "postgres" → PostgreSQL, otherwise SQL Server.
# The database must ALREADY EXIST (altea has no CREATE DATABASE); `terminal new` = clean + generate into it.

# --- PostgreSQL (libpq URL) ---
EASTWIND_DB=postgres://YOUR_USER:YOUR_PASSWORD_HERE@localhost:5432/eastwind

# --- SQL Server (mssql connection string) ---
# EASTWIND_DB=Server=localhost;Database=eastwind;User Id=YOUR_USER;Password=YOUR_PASSWORD_HERE;TrustServerCertificate=true

# --- Which ApplicationConfiguration row this process runs as -------------------------------------------
# Every module's settings (mail, chatbot keys, workflow, folders, the directories) live on ONE
# ApplicationConfiguration ROW, edited at /view/ApplicationConfiguration — Southwind's model. This names
# which row: the one whose Environment matches. The CreateCulturesAndConfiguration migration seeds a row
# with this name, so a fresh database needs nothing here.
# DB_ENVIRONMENT=Development

# --- Mail — SEED VALUES ONLY -----------------------------------------------------------------------------
# These are read ONCE, by the CreateCulturesAndConfiguration migration, to fill the new configuration row
# (so an existing .env carries over). After that the ROW is the source of truth and these are ignored;
# change the settings at /view/ApplicationConfiguration instead.
# EASTWIND_MAIL_CULTURE=en-US
# EASTWIND_MAIL_URL_LEFT=http://localhost:5173
# EASTWIND_MAIL_SEND=false
# EASTWIND_MAIL_RECEIVE=false           # the POP3 side; false makes a poll fail loudly instead of no-op
# EASTWIND_MAIL_OVERRIDE=               # send EVERY message here instead (a test catch-all)
# EASTWIND_REMOTE_EMAILS=false          # NOT a seed: it decides whether the module is started at all
                                        # (the "browse a user's Outlook mailbox" search page; needs Entra)

# --- Agent / chatbot provider keys — SEED VALUES ONLY (the row's Chatbot tab owns them afterwards) -------
# EASTWIND_AGENT_OPENAI_KEY=
# EASTWIND_AGENT_ANTHROPIC_KEY=
# EASTWIND_AGENT_GEMINI_KEY=
# EASTWIND_AGENT_MISTRAL_KEY=
# EASTWIND_AGENT_GITHUB_TOKEN=
# EASTWIND_AGENT_DEEPSEEK_KEY=
# EASTWIND_AGENT_OLLAMA_URL=

# --- File storage (see eastwindFileStores.server.ts) -----------------------------------------------------
# Which BACKEND holds the bytes of every file store (attachments, profile photos, …). "folder" is the
# default and needs nothing; the other two need @altea/altea-files-azure / -s3 credentials below. The
# backend and its credentials stay HERE (Southwind passes them to Starter.Start from appsettings); WHERE a
# local store writes is the configuration row's Folders tab, read on every write.
# EASTWIND_FILE_STORE=folder            # folder | azure | s3
# EASTWIND_FILES_EMAILATTACHMENTS=./files/emailAttachments   # SEED for the row's Folders tab ("folder" only)
# EASTWIND_FILES_PROFILEPHOTOS=./files/profilePhotos         # SEED for the row's Folders tab

# Azure Blob Storage (@altea/altea-files-azure) — one container per store, created on first write.
# EASTWIND_AZURE_STORAGE_ACCOUNT=
# EASTWIND_AZURE_STORAGE_KEY=
# EASTWIND_AZURE_STORAGE_CONNECTION_STRING=   # instead of the account + key pair

# S3 / MinIO (@altea/altea-files-s3) — see that package's docker-compose.yml.example for a local MinIO.
# EASTWIND_S3_ENDPOINT=http://localhost:9000  # omit for real AWS
# EASTWIND_S3_ACCESS_KEY=
# EASTWIND_S3_SECRET_KEY=
# EASTWIND_S3_REGION=                          # required by the AWS SDK; defaults to us-east-1
# EASTWIND_S3_BUCKET=                          # ONE shared bucket; each store becomes a key prefix in it
# EASTWIND_S3_FORCE_PATH_STYLE=true            # false for AWS virtual-hosted URLs

# --- Directory login (see eastwindAuthAD.server.ts) -----------------------------------------------------
# The three directory CONFIGURATIONS are DATA: the Azure AD / Open ID / Windows AD tabs of
# /view/ApplicationConfiguration (Southwind keeps its AzureAD there too). All three are empty on a fresh
# database, so eastwind authenticates against its own user table until one is filled in — including the
# group→role mappings and the default role, which used to be EASTWIND_AD_DEFAULT_ROLE.
#
# What stays here is only WHICH module owns the login flow, because that is decided while the schema is
# being built, before any row can be read (AuthLogic.authorizer is a single slot):
# EASTWIND_AD_PROVIDER=azuread          # azuread (default) | openid | windowsad
