{
  "name": "eastwind",
  "version": "0.0.1",
  "description": "",
  "type": "module",
  "scripts": {
    "build:types": "tspc -b",
    "build:client": "vite build --config vite.client.config.ts",
    "build:server": "vite build --config vite.server.config.ts",
    "build:terminal": "tspc -b && vite build --config vite.terminal.config.ts",
    "build": "pnpm run build:types && pnpm run build:server && pnpm run build:client",
    "dev:types": "tspc -b --watch --preserveWatchOutput",
    "dev:client": "vite --config vite.client.config.ts",
    "dev:server": "vite build --watch --config vite.server.config.ts",
    "dev": "concurrently -n types,server,client -c blue,green,magenta \"pnpm run dev:types\" \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "terminal": "node scripts/withEnv.mjs terminal",
    "terminal:bundled": "node scripts/withEnv.mjs terminal-bundled",
    "server": "node scripts/withEnv.mjs server",
    "stack": "node scripts/withEnv.mjs stack",
    "free:port": "node scripts/free-port.mjs",
    "check:modules": "node scripts/check-modules-xml.mjs",
    "test:e2e": "tspc -b && playwright test"
  },
  "keywords": [],
  "author": "Olmo del Corral",
  "license": "MIT",
