{
  "name": "eastwind",
  "version": "0.0.1",
  "description": "",
  "type": "module",
  "exports": {
    "./entities/*": {
      "types": "./dist/entities/*.d.ts",
      "default": "./dist/entities/*.js"
    },
    "./server/*": {
      "types": "./dist/server/*.d.ts",
      "default": "./dist/server/*.js"
    },
    "./client/*": {
      "types": "./dist/client/*.d.ts",
      "default": "./dist/client/*.js"
    }
  },
  "scripts": {
    "build:types": "tspc -b",
    "build:client": "vite build --config vite.client.config.ts",
    "build:server": "vite build --config vite.server.config.ts",
    "build": "pnpm run build:types && pnpm run build:server && pnpm run build:client",
    "dev:types": "tspc -b --watch --preserveWatchOutput",
    "dev:client": "vite --config vite.client.config.ts",
    "dev:server": "vite build --watch --config vite.server.config.ts",
    "dev": "concurrently -n types,server,client -c blue,green,magenta \"pnpm run dev:types\" \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "terminal:postgres": "tspc -b && node --enable-source-maps --import ./register.mjs --env-file=.env.postgres dist/terminal/terminal.js",
    "terminal:sqlserver": "tspc -b && node --enable-source-maps --import ./register.mjs --env-file=.env.sqlserver dist/terminal/terminal.js",
    "server:postgres": "node --enable-source-maps --import ./register.mjs --env-file=.env.postgres dist/server/webServer.js",
    "server:sqlserver": "node --enable-source-maps --import ./register.mjs --env-file=.env.sqlserver dist/server/webServer.js",
    "stack:postgres": "pnpm run build:types && concurrently -k -n types,api,client -c blue,green,magenta \"pnpm run dev:types\" \"pnpm run server:postgres\" \"pnpm run dev:client\"",
    "stack:sqlserver": "pnpm run build:types && concurrently -k -n types,api,client -c blue,green,magenta \"pnpm run dev:types\" \"pnpm run server:sqlserver\" \"pnpm run dev:client\""
  },
  "keywords": [],
  "author": "Olmo del Corral",
  "license": "MIT",
  "dependencies": {
    "@altea/altea": "workspace:*",
    "@altea/altea-auth": "workspace:*",
    "bootstrap": "^5.3.8",
    "quote-transformer": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "vite": "^7.0.0"
  }
}
