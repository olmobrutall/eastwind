{
  "name": "eastwind",
  "version": "0.0.1",
  "description": "",
  "type": "module",
  "scripts": {
    "build:types": "tspc -b",
    "build:client": "vite build --config vite.client.config.ts",
    "build:server": "vite build --config vite.server.config.ts",
    "build": "pnpm run build:types && pnpm run build:server && pnpm run build:client",
    "dev:types": "tspc -b --watch --preserveWatchOutput",
    "dev:client": "vite --config vite.client.config.ts",
    "dev:server": "vite build --watch --config vite.server.config.ts",
    "dev": "concurrently -n types,server,client -c blue,green,magenta \"pnpm run dev:types\" \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "terminal:postgres": "tspc -b && node --enable-source-maps --import ./register.mjs --env-file=.env.postgres dist/terminal/terminal.js",
    "terminal:sqlserver": "tspc -b && node --enable-source-maps --import ./register.mjs --env-file=.env.sqlserver dist/terminal/terminal.js",
    "free:port": "node scripts/free-port.mjs",
    "server:postgres": "node --enable-source-maps --import ./register.mjs --env-file=.env.postgres dist/webServer.server.js",
    "server:sqlserver": "node --enable-source-maps --import ./register.mjs --env-file=.env.sqlserver dist/webServer.server.js",
    "stack:postgres": "pnpm run build:types && pnpm run free:port && concurrently -k -n types,api,client -c blue,green,magenta \"pnpm run dev:types\" \"pnpm run server:postgres\" \"pnpm run dev:client\"",
    "stack:sqlserver": "pnpm run build:types && pnpm run free:port && concurrently -k -n types,api,client -c blue,green,magenta \"pnpm run dev:types\" \"pnpm run server:sqlserver\" \"pnpm run dev:client\""
  },
  "keywords": [],
  "author": "Olmo del Corral",
  "license": "MIT",
  "dependencies": {
    "@altea/altea": "workspace:*",
    "@altea/altea-auth": "workspace:*",
    "@altea/altea-chart": "workspace:*",
    "@altea/altea-codemirror": "workspace:*",
    "@altea/altea-agent": "workspace:*",
    "@altea/altea-concurrent-user": "workspace:*",
    "@altea/altea-migrations": "workspace:*",
    "@altea/altea-cache": "workspace:*",
    "@altea/altea-omnibox": "workspace:*",
    "@altea/altea-profiler": "workspace:*",
    "@altea/altea-user-assets": "workspace:*",
    "@altea/altea-user-queries": "workspace:*",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "bootstrap": "^5.3.8",
    "chalk": "^5.6.0",
    "quote-transformer": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.3.0",
    "react-widgets-up": "^6.0.14",
    "@altea/altea-dashboard": "workspace:*",
    "@altea/altea-files": "workspace:*",
    "@altea/altea-scheduler": "workspace:*",
    "@altea/altea-processes": "workspace:*",
    "@altea/altea-toolbar": "workspace:*",
    "@altea/altea-templating": "workspace:*",
    "@altea/altea-email": "workspace:*",
    "@altea/altea-office-template": "workspace:*",
    "@altea/altea-auth-reset-password": "workspace:*",
