# eastwind environment: connections, credentials and schema-build choices only.
# Everything else lives in the ApplicationConfiguration row (/view/ApplicationConfiguration).

# Database (must already exist; "postgres…" → PostgreSQL, otherwise SQL Server)
EASTWIND_DB=postgres://YOUR_USER:YOUR_PASSWORD_HERE@localhost:5432/eastwind
# EASTWIND_DB=Server=localhost,1433;Database=eastwind;User Id=YOUR_USER;Password=YOUR_PASSWORD_HERE;Encrypt=true;TrustServerCertificate=true
NORTHWIND_DB=Server=localhost,1433;Database=Northwind;User Id=YOUR_USER;Password=YOUR_PASSWORD_HERE;Encrypt=true;TrustServerCertificate=true  # demo-data source for `terminal csharp`; empty DB is enough, same dialect as EASTWIND_DB
# NORTHWIND_DB=postgresql://YOUR_USER:YOUR_PASSWORD_HERE@localhost:5432/northwind
# DB_ENVIRONMENT=Development              # which ApplicationConfiguration row this process runs as
# LegacyMode=true                         # Signum naming, to sync against a Signum-generated database

# Web host
# PORT=3001                               # the api; vite proxies /api to it
# SQL_LOG=1                               # log every statement
# AUTH_TOKEN_KEY=                         # token signing key; unset = public dev fallback (warns on boot)

# File stores: Azure if its connection string is set, else S3 if its endpoint or bucket is set, else local folders
# EASTWIND_AZURE_STORAGE_CONNECTION_STRING=

# EASTWIND_S3_ENDPOINT=http://localhost:9000  # MinIO; omit for real AWS
# EASTWIND_S3_BUCKET=                     # one shared bucket, each store a key prefix; required on AWS
# EASTWIND_S3_ACCESS_KEY=                 # omit on AWS with an IAM role
# EASTWIND_S3_SECRET_KEY=
# EASTWIND_S3_REGION=                     # defaults to us-east-1
# EASTWIND_S3_FORCE_PATH_STYLE=true       # false for AWS virtual-hosted URLs

# EASTWIND_FILE_STORE_ROOT=./files        # root of the local folders (one per store)

# Client flags go in .env.local (vite reads that file):
#   VITE_PASSWORD_IS_USERNAME=true  VITE_WINDOWS_AUTH=true  VITE_API_TARGET=http://localhost:3001