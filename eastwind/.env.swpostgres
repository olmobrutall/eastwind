
# NORTHWIND_DB=postgresql://user:password@localhost:5432/northwind
# --- PostgreSQL (libpq URL) ---
EASTWIND_DB=postgresql://user:password@localhost:5432/southwind
AUTH_TOKEN_KEY=SomeSecret
# --- Signum COMPATIBILITY ------------------------------------------------------------------------
# Name things the way Signum names them wherever altea would otherwise diverge for no reason but taste,
# so a database generated by Signum synchronizes as a MIGRATION instead of a rebuild. A schema-BUILD
# choice (SchemaSettings.legacyMode), hence an env var. Today: the `@part` row table joins to its owner
# with a SINGLE underscore on Postgres (role_inherits_from, not role__inherits_from).
LegacyMode=true
EASTWIND_FILE_STORE_ROOT=c:/SouthwindFiles