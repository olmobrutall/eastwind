{
  // CLIENT layer — React UI; references DATA only, never server (the boundary that keeps server code out
  // of the Vite bundle). `types: [react, react-dom]` overrides the preset's `[]`. The preset's `*.d.ts`
  // glob picks up styles.d.ts (ambient `declare module "*.css"` for the stylesheet side-effect imports).
  "extends": "../altea/altea/presets/client.json",
  "compilerOptions": { "types": ["react", "react-dom"] },
  "references": [
    { "path": "./tsconfig.data.json" },
    { "path": "../altea/altea-auth/tsconfig.client.json" },
    { "path": "../altea/altea-files/tsconfig.client.json" },
    { "path": "../altea/altea-scheduler/tsconfig.client.json" },
    { "path": "../altea/altea-processes/tsconfig.client.json" },
    { "path": "../altea/altea-chart/tsconfig.client.json" },
    { "path": "../altea/altea-dashboard/tsconfig.client.json" },
    { "path": "../altea/altea-omnibox/tsconfig.client.json" },
    { "path": "../altea/altea-profiler/tsconfig.client.json" },
    { "path": "../altea/altea-user-assets/tsconfig.client.json" },
    { "path": "../altea/altea-user-queries/tsconfig.client.json" },
    { "path": "../altea/altea/tsconfig.client.json" },
    { "path": "../altea/altea-toolbar/tsconfig.client.json" },
    { "path": "../altea/altea-templating/tsconfig.client.json" },
    { "path": "../altea/altea-email/tsconfig.client.json" },
    { "path": "../altea/altea-office-template/tsconfig.client.json" },
    { "path": "../altea/altea-cache/tsconfig.client.json" }
  ]
}
